#!/usr/bin/env bash
# Check that the skills installer (npx skills) can read every skill in skills/.
#
# The installer parses SKILL.md frontmatter as strict YAML and skips a skill it can't parse with only a warning,
# so `npx skills add straddle-build/skills` would silently install fewer skills than the repository ships.
# Run from the repository root. Needs Node.js 22.20 or later and network access to the npm registry.
set -euo pipefail

SKILLS_CLI="${SKILLS_CLI:-skills@1.9.0}"

listing="$(npx --yes "$SKILLS_CLI" add . --list 2>&1)" || {
    echo "$listing"
    echo "check-skills-install: \`npx $SKILLS_CLI add . --list\` failed" >&2
    exit 1
}
# The CLI colors its output whenever CI or FORCE_COLOR is set, even without a TTY, so drop ANSI escapes before matching.
listing="$(sed -E $'s/\e\\[[0-9;?]*[A-Za-z]//g' <<<"$listing")"

status=0
if grep -q "SKILLS_SKILL_SKIPPED" <<<"$listing"; then
    grep "SKILLS_SKILL_SKIPPED" <<<"$listing" >&2
    status=1
fi
for dir in skills/*/; do
    name="$(basename "$dir")"
    if ! grep -Eq "^│ +${name}[[:space:]]*$" <<<"$listing"; then
        echo "check-skills-install: the skills installer does not list $name" >&2
        status=1
    fi
done

if [[ "$status" -eq 0 ]]; then
    echo "check-skills-install: the skills installer lists all $(ls -d skills/*/ | wc -l | tr -d ' ') skills"
fi
exit "$status"
