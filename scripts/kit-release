#!/usr/bin/env python3
"""Build the checksummed Straddle plugin candidate and generate kit/manifest.yaml.

kit/manifest.yaml is a pure function of kit/release-inputs.json and the committed plugin source, so `check`
regenerates it and compares bytes. The plugin archive is built from git objects, never the working tree, and
excludes kit/, so the commit that records the manifest rebuilds the same archive. See docs/packaging.md.
"""

import argparse
import base64
import hashlib
import io
import json
import re
import subprocess
import sys
import tarfile
import tempfile
import zipfile
from importlib.machinery import SourceFileLoader
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
INPUTS = "kit/release-inputs.json"
MANIFEST = "kit/manifest.yaml"
# What a client loads. evals/, tests/, fixtures/, scripts/, docs/ and kit/ are development files.
PLUGIN_PATHS = (".claude-plugin", ".codex-plugin", ".cursor-plugin", "LICENSE", "README.md", "assets", "mcp.json",
                "plugin.json", "skills", "third_party")
ZIP_TIMESTAMP = (1980, 1, 1, 0, 0, 0)
VALIDATOR = SourceFileLoader("validate_package", str(ROOT / "scripts" / "validate-package")).load_module()
RELEASED = "released"
LOCAL_CANDIDATE = "local-candidate"


class KitError(Exception):
    pass


def git(root, *args, stdin=None):
    result = subprocess.run(["git", "-C", str(root), *args], input=stdin, capture_output=True)
    if result.returncode != 0:
        raise KitError(f"git {' '.join(args)}: {result.stderr.decode().strip()}")
    return result.stdout


def source_files(root, commit):
    """[(path, mode, bytes)] for the plugin paths at commit, sorted by path."""
    listing = git(root, "ls-tree", "-r", "-z", "--full-tree", commit, "--", *PLUGIN_PATHS).decode()
    entries = []
    for record in filter(None, listing.split("\0")):
        meta, path = record.split("\t", 1)
        mode, kind, sha = meta.split()
        if kind != "blob" or mode not in ("100644", "100755"):
            raise KitError(f"{path}: plugin files must be regular files, found {kind} {mode}")
        entries.append((path, mode, sha))
    if not entries:
        raise KitError(f"no plugin files at {commit}")
    batch = git(root, "cat-file", "--batch", stdin="".join(f"{sha}\n" for _, _, sha in entries).encode())
    files, offset = [], 0
    for path, mode, _ in entries:
        header_end = batch.index(b"\n", offset)
        size = int(batch[offset:header_end].split()[2])
        files.append((path, mode, batch[header_end + 1:header_end + 1 + size]))
        offset = header_end + 1 + size + 1
    return sorted(files)


def build_archive(files):
    """A zip with stored entries, fixed timestamps and git modes: same files, same bytes, on any zlib."""
    buffer = io.BytesIO()
    with zipfile.ZipFile(buffer, "w", zipfile.ZIP_STORED) as archive:
        for path, mode, data in files:
            info = zipfile.ZipInfo(path, ZIP_TIMESTAMP)
            info.create_system = 3
            info.external_attr = int(mode, 8) << 16
            archive.writestr(info, data)
    return buffer.getvalue()


def tree_digest(files):
    """sha256 of a sha256sum-style listing, so a directory has one digest independent of archive format."""
    listing = "".join(f"{hashlib.sha256(data).hexdigest()}  {path}\n" for path, _, data in files)
    return hashlib.sha256(listing.encode()).hexdigest()


def skill_version(text, name):
    lines, _ = VALIDATOR.split_frontmatter(text)
    metadata = VALIDATOR.parse_frontmatter(lines or [])[0].get("metadata")
    if not isinstance(metadata, dict) or not metadata.get("version"):
        raise KitError(f"skills/{name}/SKILL.md has no metadata.version")
    return metadata["version"]


def plugin_facts(files):
    by_path = {path: data for path, _, data in files}
    plugin = json.loads(by_path["plugin.json"])
    skills = sorted({path.split("/")[1] for path in by_path if path.startswith("skills/")})
    return plugin, [{
        "name": name,
        "version": skill_version(by_path[f"skills/{name}/SKILL.md"].decode(), name),
        "sha256": tree_digest([f for f in files if f[0].startswith(f"skills/{name}/")]),
    } for name in skills]


# ---------------------------------------------------------------------------
# Inputs: released components carry public proof; local candidates carry local bytes. Nothing is inferred.


PROVENANCES = (RELEASED, LOCAL_CANDIDATE)
SDKS = ("typescript", "python", "ruby", "dotnet", "go")
# Every release needs these gates passed, or deferred by a recorded decision, with evidence. They are required by name,
# so removing one from the inputs cannot remove the requirement.
REQUIRED_GATES = ("walkthrough-approval", "wizard-npm-publication", "plugin-release-tag", "clean-client-acceptance")
GATE_STATUSES = ("open", "passed", "deferred")
REPOSITORY = re.compile(r"[A-Za-z0-9][A-Za-z0-9-]*/[A-Za-z0-9._-]+")
SEMVER = re.compile(r"(\d+)\.(\d+)\.(\d+)")


def require(value, where):
    if value in (None, "", [], {}):
        raise KitError(f"{INPUTS}: {where} is required")
    return value


def require_https(value, where):
    if not isinstance(require(value, where), str) or not value.startswith("https://"):
        raise KitError(f"{INPUTS}: {where} must be an https URL")
    return value


def check_component(component, where, fields):
    require(component, where)
    for field in fields:
        require(component.get(field), f"{where}.{field}")
    if component.get("provenance") not in PROVENANCES:
        raise KitError(f"{INPUTS}: {where}.provenance must be one of {list(PROVENANCES)}")
    if "minimum_version" in fields:
        version, minimum = SEMVER.fullmatch(component["version"]), SEMVER.fullmatch(component["minimum_version"])
        if not version or not minimum:
            raise KitError(f"{INPUTS}: {where}.version and minimum_version must be x.y.z")
        if tuple(map(int, minimum.groups())) > tuple(map(int, version.groups())):
            raise KitError(f"{INPUTS}: {where}.minimum_version is newer than version")
    if component["provenance"] == RELEASED:
        evidence = require(component.get("evidence"), f"{where}.evidence")
        require_https(evidence.get("url"), f"{where}.evidence.url")
        digest = require(evidence.get("digest"), f"{where}.evidence.digest")
        require(digest.get("algorithm"), f"{where}.evidence.digest.algorithm")
        require(digest.get("value"), f"{where}.evidence.digest.value")


def check_inputs(inputs):
    """Reject an incomplete or malformed record before anything is generated from it."""
    kit = require(inputs.get("kit"), "kit")
    if kit.get("status") not in ("candidate", "release"):
        raise KitError(f"{INPUTS}: kit.status must be candidate or release")
    if not REPOSITORY.fullmatch(str(inputs.get("plugin_repository"))):
        raise KitError(f"{INPUTS}: plugin_repository must be a GitHub owner/name")
    check_component(inputs.get("cli"), "cli", ("package", "version", "minimum_version", "provenance"))
    sdks = require(inputs.get("sdks"), "sdks")
    if sorted(sdks) != sorted(SDKS):
        raise KitError(f"{INPUTS}: sdks must list exactly {list(SDKS)}")
    for name in SDKS:
        check_component(sdks[name], f"sdks.{name}", ("package", "registry", "version", "minimum_version", "provenance"))
    contract = inputs.get("contract")
    check_component(contract, "contract", ("version", "provenance"))
    mcp = require(inputs.get("hosted_mcp"), "hosted_mcp")
    for field in ("api_url", "docs_url"):
        require_https(mcp.get(field), f"hosted_mcp.{field}")
    served = require(mcp.get("contract_version_served"), "hosted_mcp.contract_version_served")
    if served != contract["version"]:
        raise KitError(f"{INPUTS}: hosted_mcp.contract_version_served must equal contract.version: the hosted MCP "
                       "reports server version latest, so it is pinned by the contract version it serves")
    wizard = require(inputs.get("wizard"), "wizard (the Wizard npm pack artifact is a true dependency)")
    for field in ("package", "version", "bin", "provenance"):
        require(wizard.get(field), f"wizard.{field}")
    if wizard["provenance"] not in PROVENANCES:
        raise KitError(f"{INPUTS}: wizard.provenance must be one of {list(PROVENANCES)}")
    if wizard["provenance"] == LOCAL_CANDIDATE:
        artifact = require(wizard.get("artifact"), "wizard.artifact")
        for field in ("file", "sha256", "integrity"):
            require(artifact.get(field), f"wizard.artifact.{field}")
        require((wizard.get("source") or {}).get("commit"), "wizard.source.commit")
    else:
        check_component(wizard, "wizard", ("package", "version", "provenance"))
    if not re.fullmatch(r"\d+\.\d+\.x", str(wizard.get("plugin_range"))):
        raise KitError(f"{INPUTS}: wizard.plugin_range must be the plugin versions the Wizard accepts, like 0.1.x")
    gates = inputs.get("gates")
    if not isinstance(gates, list) or not all(isinstance(gate, dict) for gate in gates):
        raise KitError(f"{INPUTS}: gates must be a list of gate records")
    ids = [gate.get("id") for gate in gates]
    for gate_id in sorted({i for i in ids if ids.count(i) > 1}, key=str):
        raise KitError(f"{INPUTS}: gate {gate_id} is listed more than once")
    for gate_id in REQUIRED_GATES:
        if gate_id not in ids:
            raise KitError(f"{INPUTS}: required gate {gate_id} is missing")
    for gate in gates:
        require(gate.get("requirement"), f"gate {gate.get('id')}.requirement")
        if gate.get("status") not in GATE_STATUSES:
            raise KitError(f"{INPUTS}: gate {gate.get('id')}.status must be one of {list(GATE_STATUSES)}")


def check_source_binding(inputs, files, plugin_version):
    """The inputs must describe the plugin at this commit: its MCP servers and a Wizard that accepts its version."""
    servers = json.loads(dict((p, d) for p, _, d in files)["mcp.json"])["mcpServers"]
    for server, field in (("straddle-api", "api_url"), ("straddle-docs", "docs_url")):
        if servers.get(server, {}).get("url") != inputs["hosted_mcp"][field]:
            raise KitError(f"{INPUTS}: hosted_mcp.{field} does not match {server} in mcp.json")
    accepted = inputs["wizard"]["plugin_range"]
    if not re.fullmatch(re.escape(accepted[:-1]) + r"\d+", plugin_version):
        raise KitError(f"{INPUTS}: plugin {plugin_version} is outside wizard.plugin_range {accepted}; the recorded "
                       "Wizard would refuse this plugin, so record a Wizard that accepts it")


def release_problems(inputs, plugin_version, root, commit):
    """Why this manifest cannot be validated as a published release. Empty only with public proof for everything."""
    problems = []
    if inputs["kit"]["status"] != "release":
        problems.append(f"kit.status is {inputs['kit']['status']!r}; a published release requires 'release'")
    components = {"cli": inputs["cli"], "contract": inputs["contract"], "hosted_mcp": inputs["hosted_mcp"],
                  "wizard": inputs["wizard"], **{f"sdks.{k}": v for k, v in sorted(inputs["sdks"].items())}}
    for name, component in components.items():
        if component.get("provenance") != RELEASED:
            problems.append(f"{name}: provenance is {component.get('provenance')!r}, not published")
            continue
        evidence = component.get("evidence") or {}
        if name == "hosted_mcp":
            if not evidence.get("observed_at"):
                problems.append("hosted_mcp: no observation of the contract version it serves")
        elif not evidence.get("url") or not (evidence.get("digest") or {}).get("value"):
            problems.append(f"{name}: released without a public url and digest in evidence")
    release = inputs.get("plugin_release") or {}
    tag = f"v{plugin_version}"
    if release.get("tag") != tag or not release.get("checksum_url"):
        problems.append(f"plugin: no published release (plugin_release.tag {tag} and checksum_url)")
    else:
        try:
            if git(root, "rev-parse", f"{tag}^{{commit}}").strip() != git(root, "rev-parse", commit).strip():
                problems.append(f"plugin: tag {tag} does not point at {commit}")
        except KitError:
            problems.append(f"plugin: tag {tag} does not exist in this repository")
    for gate in inputs.get("gates", []):
        if gate.get("status") not in ("passed", "deferred"):
            problems.append(f"gate {gate.get('id')}: {gate.get('status')}")
        elif not gate.get("evidence"):
            problems.append(f"gate {gate.get('id')}: {gate.get('status')} but missing evidence")
    return problems


# ---------------------------------------------------------------------------
# Instructions, generated from manifest facts. Each operation is one shell script: a `set -eu` subshell, so any failed
# step stops it, and an interrupted or pasted run cannot fall through to a later step. Plugin operations keep a
# per-client, kit-owned marketplace directory under $STRADDLE_KIT_DIR. Install and update build the replacement in
# <dir>.new from the plugin files only and require it to be exactly the verified plugin before touching the client.
# A release materializes those files from a tag checkout, so hooks or other auto-loaded root entries in the
# repository never reach a client. Update swaps directories and restores the previous one if the client refresh fails.

KIT_DIR_GUARD = ': "${STRADDLE_KIT_DIR:?set STRADDLE_KIT_DIR to a durable directory for Straddle kit artifacts}"'


def script(*lines):
    return "(\n  set -eu\n" + "".join(f"  {line}\n" for line in lines) + ")"


def content_check(directory, digest):
    """Exactly the verified plugin: only plugin paths at the root, only regular files, and plugin.content_sha256."""
    only_plugin_paths = (f"cd {directory} && find . -mindepth 1 -maxdepth 1 "
                         + " ".join(f"! -name {path}" for path in PLUGIN_PATHS))
    only_files = f"cd {directory} && find . ! -type f ! -type d"
    listing = (f"cd {directory} && find {' '.join(PLUGIN_PATHS)} -type f | LC_ALL=C sort | "
               'while IFS= read -r f; do shasum -a 256 "$f"; done | shasum -a 256 | cut -c1-64')
    return (f'{{ test -z "$({only_plugin_paths})" && test -z "$({only_files})" && test "$({listing})" = "{digest}"; }} '
            f'|| {{ echo "{directory} is not exactly the verified plugin (plugin.content_sha256 {digest}): unexpected '
            f'entries, links or content" >&2; rm -rf {directory}; exit 1; }}')


def plugin_operations(client_dir, acquire, register, refresh, unregister, validate):
    staged, backup = f"{client_dir}.new", f"{client_dir}.old"
    return {
        "install": script(KIT_DIR_GUARD, 'cd "$STRADDLE_KIT_DIR"', f"rm -rf {staged}", *acquire(staged),
                          f"rm -rf {client_dir}", f"mv {staged} {client_dir}", *register(f'"$PWD/{client_dir}"')),
        "update": script(
            KIT_DIR_GUARD, 'cd "$STRADDLE_KIT_DIR"',
            f'test -d {client_dir} || {{ echo "no installed plugin directory $PWD/{client_dir}; run install" >&2; exit 1; }}',
            f"rm -rf {staged} {backup}", *acquire(staged),
            f"mv {client_dir} {backup}", f"mv {staged} {client_dir}",
            f"if {refresh}; then",
            f"  rm -rf {backup}",
            "else",
            '  echo "update failed; restoring the previous plugin" >&2',
            f"  rm -rf {client_dir}", f"  mv {backup} {client_dir}", f"  {refresh} || true", "  exit 1",
            "fi"),
        "remove": script(KIT_DIR_GUARD, *unregister, f'rm -rf "$STRADDLE_KIT_DIR/{client_dir}"'),
        "validate": script(*validate),
    }


def instructions(plugin, archive_name, archive_sha, content_sha256, skill_count, inputs):
    name, version = plugin["name"], plugin["version"]
    market = f"{name}@{name}"
    tag = f"v{version}"
    git_url = f"https://github.com/{inputs['plugin_repository']}.git"
    api_url = inputs["hosted_mcp"]["api_url"]
    servers = json.dumps({"straddle-api": api_url, "straddle-docs": inputs["hosted_mcp"]["docs_url"]})
    wizard = inputs["wizard"]

    def candidate(staged):
        return [f'echo "{archive_sha}  {archive_name}" | shasum -a 256 -c -', f"unzip -q {archive_name} -d {staged}",
                content_check(staged, content_sha256)]

    def release(staged):
        checkout = f"{staged}.src"
        return [f"rm -rf {checkout}", f"git clone -q --depth 1 --branch {tag} {git_url} {checkout}",
                f"mkdir {staged}",
                f"git -C {checkout} archive --format=tar HEAD -- {' '.join(PLUGIN_PATHS)} | tar -x -C {staged} -f -",
                f"rm -rf {checkout}", content_check(staged, content_sha256)]

    claude_refresh = f"claude plugin marketplace update {name} && claude plugin update {market}"
    claude_validate = [
        f"claude plugin list --json | python3 -c 'import json,sys; p={{x[\"id\"]: x for x in json.load(sys.stdin)}}"
        f"[\"{market}\"]; assert p[\"version\"]==\"{version}\" and p[\"enabled\"] and "
        f"{{k: v[\"url\"] for k, v in p[\"mcpServers\"].items()}}=={servers}, p'",
    ]
    codex_validate = [
        f"codex plugin list --json | python3 -c 'import json,sys; p={{x[\"pluginId\"]: x for x in "
        f"json.load(sys.stdin)[\"installed\"]}}[\"{market}\"]; assert p[\"version\"]==\"{version}\" and p[\"enabled\"], p'",
        f"codex mcp list --json | python3 -c 'import json,sys; t={{x[\"name\"]: x.get(\"transport\") or {{}} for x in "
        f"json.load(sys.stdin) if x.get(\"enabled\")}}; s={{k: t.get(k, {{}}).get(\"url\")==v for k, v in "
        f"{servers}.items()}}; s[\"straddle-api bearer_token_env_var is STRADDLE_API_KEY\"]="
        f"t.get(\"straddle-api\", {{}}).get(\"bearer_token_env_var\")==\"STRADDLE_API_KEY\"; all(s.values()) or "
        f"sys.exit(\"Codex Straddle MCP configuration does not match: \" + json.dumps(s))'",
    ]

    def claude(acquire):
        return plugin_operations(
            "claude-code-plugin", acquire,
            lambda path: [f"claude plugin marketplace add {path}", f"claude plugin install {market}"],
            claude_refresh, [f"claude plugin uninstall {market}", f"claude plugin marketplace remove {name}"],
            claude_validate)

    def codex(acquire):
        return plugin_operations(
            "codex-plugin", acquire,
            lambda path: [f"codex plugin marketplace add {path}", f"codex plugin add {market}"],
            f"codex plugin add {market}",
            [f"codex plugin remove {market}", f"codex plugin marketplace remove {name}"],
            codex_validate)

    wizard_spec = f"{wizard['package']}@{wizard['version']}"
    wizard_validate = [f"test \"$({wizard['bin']} --version)\" = \"{wizard['version']}\""]
    published_integrity = ((wizard.get("evidence") or {}).get("digest") or {}).get("value")
    if wizard["provenance"] == RELEASED and published_integrity:
        wizard_validate.append(f"test \"$(npm view {wizard_spec} dist.integrity)\" = \"{published_integrity}\"")
    wizard_candidate = None
    if wizard["provenance"] == LOCAL_CANDIDATE:
        artifact = wizard["artifact"]
        from_tarball = script(KIT_DIR_GUARD, 'cd "$STRADDLE_KIT_DIR"',
                              f'echo "{artifact["sha256"]}  {artifact["file"]}" | shasum -a 256 -c -',
                              f'npm install --global "$PWD/{artifact["file"]}"')
        wizard_candidate = {"install": from_tarball, "update": from_tarball,
                            "remove": script(f"npm uninstall --global {wizard['package']}"),
                            "validate": script(*wizard_validate)}
    return {
        "wizard": {
            "candidate": wizard_candidate,
            "release": {
                "install": script(f"npm install --global {wizard_spec}"),
                "update": script(f"npm install --global {wizard_spec}"),
                "remove": script(f"npm uninstall --global {wizard['package']}"),
                "validate": script(*wizard_validate),
            },
        },
        "claude-code": {
            "notes": ["Start Claude Code from a shell where STRADDLE_API_KEY is set; the plugin sends it as the "
                      "straddle-api bearer token."],
            "candidate": claude(candidate),
            "release": claude(release),
        },
        "codex": {
            "notes": ["Start Codex from a shell where STRADDLE_API_KEY is set; the plugin's straddle-api server reads "
                      "its bearer token from that variable. Validate checks the variable name, never its value.",
                      "A client-level straddle-api server from an older install is left developer-managed "
                      "(remove with 'codex mcp remove straddle-api')."],
            "candidate": codex(candidate),
            "release": codex(release),
        },
        "cursor": {
            "manual": True,
            "notes": ["Cursor serves a team marketplace from the repository's default branch. Its import takes only "
                      "the owner/repo URL and has no tag, branch or version control, so it can't select or pin tag "
                      f"{tag}.",
                      "Cursor's copy is not checked against SHA256SUMS or plugin.content_sha256. Validate checks the "
                      "installed version metadata, the skill count and the MCP server names, not file contents.",
                      "Saving STRADDLE_API_KEY in Configure and an authenticated straddle-api call have not been "
                      "exercised in Cursor."],
            "candidate": "not available from a local archive: Cursor imports a team marketplace from a GitHub "
                         "repository's default branch",
            "release": {
                "install": [f"Import https://github.com/{inputs['plugin_repository']} as a team marketplace, in the "
                            "Cursor team dashboard or in the Cursor IDE.",
                            "In the Cursor IDE, add the Straddle plugin from that marketplace.",
                            "Open the Straddle plugin's Configure and enter your Straddle API key for "
                            "STRADDLE_API_KEY. Cursor doesn't ask for it when you add the plugin."],
                "update": ["Refresh the team marketplace, or keep its Auto Refresh on, so Cursor reads the "
                           "repository's default branch again."],
                "remove": ["Uninstall the Straddle plugin, then remove the team marketplace."],
                "validate": [f"Check that the installed copy's .cursor-plugin/plugin.json, under "
                             f"~/.cursor/plugins/cache/, has version {version}.",
                             f"Check that Cursor shows {skill_count} straddle-* skills and the straddle-api and "
                             "straddle-docs MCP servers for the Straddle plugin."],
            },
        },
    }


# ---------------------------------------------------------------------------
# Manifest.


def archive_file(version):
    return f"straddle-plugin-{version}.zip"


def manifest_model(root, commit, inputs):
    """The manifest as data. `generate` renders it; tests and consumers can read it without a YAML parser."""
    check_inputs(inputs)
    files = source_files(root, commit)
    plugin, skills = plugin_facts(files)
    content_sha256 = tree_digest(files)
    check_source_binding(inputs, files, plugin["version"])
    archive = build_archive(files)
    archive_name = archive_file(plugin["version"])
    archive_sha = hashlib.sha256(archive).hexdigest()
    kit = inputs["kit"]
    release = inputs.get("plugin_release") if kit["status"] == "release" else None
    return {
        "schema": 1,
        "kit": {"name": "straddle-developer-kit", "version": plugin["version"], "status": kit["status"]},
        "plugin": {
            "name": plugin["name"],
            "version": plugin["version"],
            "provenance": RELEASED if release else LOCAL_CANDIDATE,
            "repository": inputs["plugin_repository"],
            "archive": {"file": archive_name, "format": "zip, stored entries, fixed timestamps",
                        "sha256": archive_sha, "bytes": len(archive), "files": len(files)},
            "content_sha256": content_sha256,
            "release": release,
        },
        "skills": skills,
        "wizard": inputs["wizard"],
        "cli": inputs["cli"],
        "sdks": inputs["sdks"],
        "contract": inputs["contract"],
        "hosted_mcp": inputs["hosted_mcp"],
        "clients": inputs.get("clients", {}),
        "instructions": instructions(plugin, archive_name, archive_sha, content_sha256, len(skills), inputs),
        "gates": inputs["gates"],
    }


def generate(root, commit, inputs):
    header = (f"# Generated by scripts/kit-release generate from {INPUTS}. Do not edit.\n"
              "# Provenance local-candidate means built locally and not published; see docs/packaging.md.\n")
    return header + to_yaml(manifest_model(root, commit, inputs))


def scalar(value):
    if value is None:
        return "null"
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, int):
        return str(value)
    return json.dumps(value, ensure_ascii=False)


def to_yaml(value, indent=0):
    pad = "  " * indent
    if isinstance(value, dict):
        if not value:
            return " {}\n"
        return "\n" + "".join(f"{pad}{key}:{to_yaml(item, indent + 1)}" for key, item in value.items())
    if isinstance(value, list):
        if not value:
            return " []\n"
        out = "\n"
        for item in value:
            if isinstance(item, dict) and item:
                body = to_yaml(item, indent + 1)[1:]
                out += f"{pad}- {body[len(pad) + 2:]}"
            else:
                out += f"{pad}-{to_yaml(item, indent + 1)}"
        return out
    if isinstance(value, str) and "\n" in value and not value.startswith((" ", "\t")) \
            and not any(line != line.rstrip() for line in value.split("\n")):
        return " |-\n" + "".join(f"{pad}{line}\n" if line else "\n" for line in value.split("\n"))
    return f" {scalar(value)}\n"


def npm_integrity(data):
    return "sha512-" + base64.b64encode(hashlib.sha512(data).digest()).decode()


# Loads the packed Wizard's own release verifier and runs it on the plugin archive and SHA256SUMS this commit publishes,
# the same bytes the Wizard downloads from the GitHub release.
UNPACK_RELEASE = """
import { readFileSync } from 'node:fs';
const [verifier, version, archive, sums, dest] = process.argv.slice(1);
const { unpackRelease } = await import(new URL(`file://${verifier}`));
if (typeof unpackRelease !== 'function') { console.log(JSON.stringify({ ok: false, reason: 'no unpackRelease export' })); }
else {
  const r = unpackRelease({ version, archive: readFileSync(archive), sums: readFileSync(sums, 'utf8') }, dest);
  console.log(JSON.stringify({ ok: r.ok, reason: r.reason ?? null }));
}
"""


def wizard_problems(root, commit, wizard, tarball):
    """The tarball is the recorded Wizard, and it accepts the plugin release this commit publishes.

    Importing bundle.js runs the pack's code, so nothing is extracted until the bytes match the recorded digests, and
    nothing is imported until package.json matches the recorded identity. A local candidate is checked against
    wizard.artifact; a released Wizard against the npm dist.integrity in wizard.evidence.digest.
    """
    data, artifact, problems = tarball.read_bytes(), wizard.get("artifact") or {}, []
    if wizard["provenance"] == LOCAL_CANDIDATE:
        if hashlib.sha256(data).hexdigest() != artifact.get("sha256"):
            problems.append(f"{tarball}: sha256 does not match wizard.artifact.sha256")
        if npm_integrity(data) != artifact.get("integrity"):
            problems.append(f"{tarball}: integrity does not match wizard.artifact.integrity")
    elif npm_integrity(data) != ((wizard.get("evidence") or {}).get("digest") or {}).get("value"):
        problems.append(f"{tarball}: integrity does not match wizard.evidence.digest.value")
    if problems:
        return problems
    if not hasattr(tarfile, "data_filter"):
        raise KitError(f"check --wizard-tarball needs Python 3.12 or later (tarfile data filter); this is "
                       f"Python {sys.version.split()[0]}")
    with tempfile.TemporaryDirectory() as scratch:
        scratch = Path(scratch)
        with tarfile.open(fileobj=io.BytesIO(data)) as pack:
            pack.extractall(scratch / "wizard", filter="data")
        package = json.loads((scratch / "wizard" / "package" / "package.json").read_text())
        if package.get("name") != wizard["package"] or package.get("version") != wizard["version"] \
                or wizard["bin"] not in (package.get("bin") or {}):
            return [f"{tarball}: package.json name, version or bin differs from wizard in {INPUTS}"]
        files = source_files(root, commit)
        version = plugin_facts(files)[0]["version"]
        archive = build_archive(files)
        (scratch / "archive.zip").write_bytes(archive)
        (scratch / "SHA256SUMS").write_text(f"{hashlib.sha256(archive).hexdigest()}  {archive_file(version)}\n")
        run = subprocess.run(["node", "--input-type=module", "-e", UNPACK_RELEASE,
                              str(scratch / "wizard" / "package" / "dist" / "bundle.js"), version,
                              str(scratch / "archive.zip"), str(scratch / "SHA256SUMS"), str(scratch / "plugin")],
                             capture_output=True, text=True)
        result = json.loads(run.stdout) if run.returncode == 0 else {"ok": False, "reason": run.stderr.strip()}
        if not result["ok"]:
            problems.append(f"{tarball}: the Wizard refuses plugin release {version} at {commit}: {result['reason']}")
    return problems


def main(argv):
    parser = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    parser.add_argument("--root", type=Path, default=ROOT)
    commands = parser.add_subparsers(dest="command", required=True)
    for name, text in (("build", "write the plugin candidate and SHA256SUMS to --out"),
                       ("generate", f"write {MANIFEST}"),
                       ("check", f"regenerate {MANIFEST} and compare; --release demands published proof")):
        sub = commands.add_parser(name, help=text)
        sub.add_argument("--commit", default="HEAD", help="source commit (default HEAD)")
        if name == "build":
            sub.add_argument("--out", type=Path, default=ROOT / "dist")
        if name == "check":
            sub.add_argument("--release", action="store_true", help="validate as a published release")
            sub.add_argument("--wizard-tarball", type=Path, help="verify these bytes against wizard.artifact")
    args = parser.parse_args(argv)
    root = args.root.resolve()
    try:
        commit = git(root, "rev-parse", "--verify", f"{args.commit}^{{commit}}").decode().strip()
        if args.command == "build":
            files = source_files(root, commit)
            archive = build_archive(files)
            archive_name = archive_file(plugin_facts(files)[0]["version"])
            digest = hashlib.sha256(archive).hexdigest()
            args.out.mkdir(parents=True, exist_ok=True)
            (args.out / archive_name).write_bytes(archive)
            (args.out / "SHA256SUMS").write_text(f"{digest}  {archive_name}\n")
            print(f"{args.out / archive_name}: sha256 {digest}, {len(archive)} bytes, {len(files)} files, "
                  f"from {commit}, provenance {LOCAL_CANDIDATE}")
            return 0
        inputs = json.loads((root / INPUTS).read_text())
        text = generate(root, commit, inputs)
        if args.command == "generate":
            (root / MANIFEST).write_text(text)
            print(f"{MANIFEST}: generated from {commit}")
            return 0
        problems = []
        committed = root / MANIFEST
        if not committed.is_file() or committed.read_text() != text:
            problems.append(f"{MANIFEST} does not match plugin source at {commit} and {INPUTS}; "
                            "run scripts/kit-release generate")
        if args.wizard_tarball:
            problems += wizard_problems(root, commit, inputs["wizard"], args.wizard_tarball)
        if args.release:
            problems += release_problems(inputs, json.loads(git(root, "show", f"{commit}:plugin.json"))["version"],
                                         root, commit)
    except (KitError, OSError, json.JSONDecodeError, KeyError) as error:
        print(f"kit-release: {error}", file=sys.stderr)
        return 1
    for problem in problems:
        print(f"kit-release: {problem}")
    mode = "published release" if args.release else "local candidate"
    verdict = "FAIL" if problems else "ok"
    print(f"kit-release check ({mode}) at {commit}: {verdict}", file=sys.stderr)
    return 1 if problems else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
